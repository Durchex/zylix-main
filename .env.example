# =========================================================
# ZYLIX — Environment Variables
#
# The app is a single Next.js deployment on Vercel (apps/web) — there is no
# separate API service anymore. Copy this file to apps/web/.env.local for
# local dev, and set the same keys in the Vercel project's Environment
# Variables for Production/Preview/Development.
# =========================================================

# --- App ---
NODE_ENV=development
# The app's own public URL. Used to build links in emails (verification,
# password reset) and the checkout-confirmation redirect — not for CORS,
# since the API and the site are the same origin now.
APP_URL=http://localhost:3000

# --- Database (MongoDB via Mongoose) ---
# A local single-node replica set is required for transactions (order
# placement, seller-free checkout stock decrements) even in dev — a plain
# `mongod` without --replSet will fail those specific operations. Atlas
# (any tier) is already a replica set. See docs/DEPLOYMENT.md.
MONGODB_URI=mongodb://localhost:27017/zylix?replicaSet=rs0
MONGODB_DB=zylix

# --- Auth / JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
TWO_FACTOR_ISSUER=ZylixStore

# One-time admin bootstrap: POST /api/v1/setup/admin with
# { "secret": "<this value>", "email": ..., "password": ... } — for hosts
# like Vercel where there's no shell access to run a seed script directly.
SETUP_SECRET=

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: Africa-first primary providers ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Payments: global secondary providers ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APPLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_ID=

# --- Support / Messaging ---
WHATSAPP_BUSINESS_NUMBER=
LIVE_CHAT_WIDGET_KEY=
NEWSLETTER_PROVIDER_API_KEY=

# --- Currency / Locale ---
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en
