# =========================================================
# ZYLIX — Environment Variables
#
# The app is a single Next.js deployment on Vercel (apps/web) — there is no
# separate API service anymore. Copy this file to apps/web/.env.local for
# local dev, and set the same keys in the Vercel project's Environment
# Variables for Production/Preview/Development.
# =========================================================

# --- App ---
NODE_ENV=development
# The app's own public URL. Used to build links in emails (verification,
# password reset) and the checkout-confirmation redirect — not for CORS,
# since the API and the site are the same origin now.
APP_URL=http://localhost:3000

# --- Database (MongoDB via Mongoose) ---
# A local single-node replica set is required for transactions (order
# placement, seller-free checkout stock decrements) even in dev — a plain
# `mongod` without --replSet will fail those specific operations. Atlas
# (any tier) is already a replica set. See docs/DEPLOYMENT.md.
MONGODB_URI=mongodb://localhost:27017/zylix?replicaSet=rs0
MONGODB_DB=zylix

# --- Auth / JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
TWO_FACTOR_ISSUER=ZylixStore

# One-time admin bootstrap: POST /api/v1/setup/admin with
# { "secret": "<this value>", "email": ..., "password": ... } — for hosts
# like Vercel where there's no shell access to run a seed script directly.
SETUP_SECRET=

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: cards, bank, USSD, mobile money (Flutterwave) ---
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Payments: cryptocurrency (NOWPayments) ---
# Both are required before crypto is offered at checkout: the API key creates
# invoices, and the IPN secret (generated separately under Payment Settings in
# their dashboard) is what signs callbacks. Without the secret there's no safe
# way to learn a payment succeeded, so the option stays hidden.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sandbox: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- Logistics (Shipbubble) ---
# The key prefix picks the environment: sb_sandbox for test, sb_prod for live.
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_BASE_URL=https://api.shipbubble.com/v1

# --- Address search (Google Places) ---
# Server-side only — Places requests are proxied through /api/v1/places/* so
# the key is never exposed to the browser.
GOOGLE_MAPS_API_KEY=

# --- Support / Messaging ---
# The public support/WhatsApp number is not an env var — it's rendered in
# client components and isn't a secret, so it lives in apps/web/src/lib/
# contact.ts where the display, tel: and wa.me forms are all derived from one
# value. Change it there.
LIVE_CHAT_WIDGET_KEY=
NEWSLETTER_PROVIDER_API_KEY=

# --- Currency / Locale ---
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en
