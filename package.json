{
  "name": "zylix",
  "private": true,
  "version": "1.0.0",
  "description": "ZYLIX - Technology Made Simple. Powered by Durchex D.A.M Company LTD.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run --workspace=@zylix/web dev",
    "build": "npm run build:web",
    "build:web": "npm run --workspace=@zylix/web build",
    "start:web": "npm run --workspace=@zylix/web start",
    "lint": "npm run lint:web",
    "lint:web": "npm run --workspace=@zylix/web lint",
    "test": "npm run test:web",
    "test:web": "npm run --workspace=@zylix/web test",
    "postinstall": "node scripts/postinstall.js",
    "_comment_legacy_api": "apps/api (Express + Prisma/Postgres, deployed on Render) is being decommissioned in favor of route handlers inside apps/web on Mongoose/MongoDB + Vercel. Its own scripts still work directly (npm run --workspace=@zylix/api <script>) until it's removed.",
    "dev:api": "npm run --workspace=@zylix/api dev",
    "build:api": "npm run --workspace=@zylix/api build",
    "start:api": "npm run --workspace=@zylix/api start",
    "lint:api": "npm run --workspace=@zylix/api lint",
    "test:api": "npm run --workspace=@zylix/api test",
    "prisma:generate": "npm run --workspace=@zylix/api prisma:generate",
    "prisma:migrate": "npm run --workspace=@zylix/api prisma:migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
