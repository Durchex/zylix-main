{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // Build output. `.next/types` is still pulled in by `include` above (Next
    // generates route type definitions there), but the rest — the dev server's
    // chunk cache and the standalone bundle, which together carry a copy of
    // every traced dependency — is compiled source, and handing it to tsc is
    // what pushed the typecheck into an out-of-memory crash.
    ".next/cache",
    ".next/dev",
    ".next/server",
    ".next/static",
    ".next/standalone",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.config.js",
    "jest.setup.ts"
  ]
}
